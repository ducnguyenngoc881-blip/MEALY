      },
      "3xl": {
        "$value": "30px",
        "fontSize": "30px",
        "lineHeight": "36px",
        "letterSpacing": "-0.02em",
        "px": 30,
        "$type": "typography",
        "$description": "Section H2 headers, modal prominent titles"
      },
      "4xl": {
        "$value": "36px",
        "fontSize": "36px",
        "lineHeight": "40px",
        "letterSpacing": "-0.025em",
        "px": 36,
        "$type": "typography",
        "$description": "Page H1 headlines, featured article titles"
      },
      "5xl": {
        "$value": "48px",
        "fontSize": "48px",
        "lineHeight": "48px",
        "letterSpacing": "-0.03em",
        "px": 48,
        "$type": "typography",
        "$description": "Marketing hero headlines, major display statistics"
      },
      "6xl": {
        "$value": "60px",
        "fontSize": "60px",
        "lineHeight": "60px",
        "letterSpacing": "-0.03em",
        "px": 60,
        "$type": "typography",
        "$description": "Monumental Remotion video title cards, billboard titles"
      }
    }
  },
  "radii": {
    "none": { "$value": "0px", "px": 0, "$type": "dimension", "$description": "Square geometric edges, full-bleed containers" },
    "sm": { "$value": "4px", "px": 4, "$type": "dimension", "$description": "Subtle rounding: tags, badges, nested checkboxes" },
    "md": { "$value": "8px", "px": 8, "$type": "dimension", "$description": "Default component rounding: buttons, input fields" },
    "lg": { "$value": "12px", "px": 12, "$type": "dimension", "$description": "Card containers, alert banners, floating popovers" },
    "xl": { "$value": "16px", "px": 16, "$type": "dimension", "$description": "Large cards, modal dialogs, flyout drawers" },
    "2xl": { "$value": "24px", "px": 24, "$type": "dimension", "$description": "Floating hero panels, spotlight cards" },
    "full": { "$value": "9999px", "px": 9999, "$type": "dimension", "$description": "Circular avatars, rounded pill buttons" }
  },
  "elevation": {
    "elevation-1": {
      "$value": "0 1px 3px 0 rgba(0,0,0,0.06), 0 1px 2px -1px rgba(0,0,0,0.06)",
      "$type": "shadow",
      "$description": "Subtle elevation for cards and table row hover states"
    },
    "elevation-2": {
      "$value": "0 4px 6px -1px rgba(0,0,0,0.08), 0 2px 4px -2px rgba(0,0,0,0.06)",
      "$type": "shadow",
      "$description": "Interactive popovers, select dropdown menus"
    },
    "elevation-3": {
      "$value": "0 10px 15px -3px rgba(0,0,0,0.10), 0 4px 6px -4px rgba(0,0,0,0.08)",
      "$type": "shadow",
      "$description": "Modal dialogs, sticky navigation headers"
    },
    "elevation-4": {
      "$value": "0 20px 25px -5px rgba(0,0,0,0.12), 0 8px 10px -6px rgba(0,0,0,0.08)",
      "$type": "shadow",
      "$description": "Floating notifications, contextual flyout drawers"
    },
    "elevation-5": {
      "$value": "0 25px 50px -12px rgba(0,0,0,0.22)",
      "$type": "shadow",
      "$description": "High-altitude modal backdrops, floating video overlays"
    }
  },
  "motion": {
    "spring": {
      "springGentle": {
        "$value": "springGentle",
        "mass": 1.0,
        "damping": 20,
        "stiffness": 100,
        "dampingRatio": 1.000,
        "$type": "motion",
        "$description": "Silky smooth, critically damped motion with zero overshoot"
      },
      "springSnappy": {
        "$value": "springSnappy",
        "mass": 0.8,
        "damping": 14,
        "stiffness": 180,
        "dampingRatio": 0.583,
        "$type": "motion",
        "$description": "Fast tactile response for UI button presses and toggles"
      },
      "springBouncy": {
        "$value": "springBouncy",
        "mass": 1.2,
        "damping": 10,
        "stiffness": 140,
        "dampingRatio": 0.386,
        "$type": "motion",
        "$description": "Playful elastic oscillation for celebratory badges and stickers"
      },
      "springStiff": {
        "$value": "springStiff",
        "mass": 0.5,
        "damping": 20,
        "stiffness": 260,
        "dampingRatio": 0.877,
        "$type": "motion",
        "$description": "Crisp rapid transitions for accordion expansions and tab switches"
      },
      "springHeavy": {
        "$value": "springHeavy",
        "mass": 2.0,
        "damping": 30,
        "stiffness": 120,
        "dampingRatio": 0.968,
        "$type": "motion",
        "$description": "Cinematic inertial weight for full-screen title cards"
      },
      "snappy": {
        "$value": "snappy",
        "mass": 0.5,
        "damping": 15,
        "stiffness": 200,
        "dampingRatio": 0.75,
        "$type": "motion",
        "$description": "Fast responsive tactile spring preset matching motion-engine.ts"
      },
      "smooth": {
        "$value": "smooth",
        "mass": 1.0,
        "damping": 30,
        "stiffness": 100,
        "dampingRatio": 1.50,
        "$type": "motion",
        "$description": "Smooth gentle spring preset matching motion-engine.ts"
      },
      "bouncy": {
        "$value": "bouncy",
        "mass": 0.8,
        "damping": 8,
        "stiffness": 150,
        "dampingRatio": 0.365,
        "$type": "motion",
        "$description": "Bouncy elastic spring preset matching motion-engine.ts"
      },
      "heavy": {
        "$value": "heavy",
        "mass": 2.0,
        "damping": 40,
        "stiffness": 300,
        "dampingRatio": 0.816,
        "$type": "motion",
        "$description": "Heavy inertial spring preset matching motion-engine.ts"
      }
    },
    "transition": {
      "duration": {
        "instant": { "$value": "50ms", "ms": 50, "$type": "duration", "$description": "Instantaneous toggle feedback" },
        "fast": { "$value": "150ms", "ms": 150, "$type": "duration", "$description": "Hover state transitions and small tooltips" },
        "normal": { "$value": "250ms", "ms": 250, "$type": "duration", "$description": "Standard modal and dropdown expansions" },
        "slow": { "$value": "400ms", "ms": 400, "$type": "duration", "$description": "Page transitions and large sheet animations" },
        "deliberate": { "$value": "600ms", "ms": 600, "$type": "duration", "$description": "Complex multi-step choreographies" }
      },
      "easing": {
        "easeOut": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier", "$description": "Decelerates naturally into rest position" },
        "easeInOut": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)", "$type": "cubicBezier", "$description": "Balanced acceleration and deceleration" },
        "easeIn": { "$value": "cubic-bezier(0.32, 0, 0.67, 0)", "$type": "cubicBezier", "$description": "Accelerates cleanly off-screen during exits" },
        "spring": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "CSS curve approximating spring overshoot" }
      }
    }
  },
  "touch": {
    "minTouchTarget": {
      "$value": "44px",
      "px": 44,
      "$type": "dimension",
      "$description": "Minimum iOS touch target bounding box (44x44px)"
    },
    "minTarget": {
      "$value": "44px",
      "px": 44,
      "$type": "dimension",
      "$description": "Canonical minimum touch target alias"
    },
    "androidTouchTarget": {
      "$value": "48px",
      "px": 48,
      "$type": "dimension",
      "$description": "Minimum Android Material touch target bounding box (48x48px)"
    },
    "compactTarget": {
      "$value": "36px",
      "px": 36,
      "$type": "dimension",
      "$description": "Compact touch target with padding shield (36x36px)"
    }
  },
  "safeArea": {
    "insetTop": {
      "$value": "47px",
      "px": 47,
      "env": "env(safe-area-inset-top, 0px)",
      "$type": "dimension",
      "$description": "Safe area top inset for notches and Dynamic Island"
    },
    "insetBottom": {
      "$value": "34px",
      "px": 34,
      "env": "env(safe-area-inset-bottom, 0px)",
      "$type": "dimension",
      "$description": "Safe area bottom inset for home gesture swipe indicators"
    },
    "insetLeft": {
      "$value": "0px",
      "px": 0,
      "env": "env(safe-area-inset-left, 0px)",
      "$type": "dimension",
      "$description": "Safe area left inset for landscape mode orientation"
    },
    "insetRight": {
      "$value": "0px",
      "px": 0,
      "env": "env(safe-area-inset-right, 0px)",
      "$type": "dimension",
      "$description": "Safe area right inset for landscape mode orientation"
    },
    "top": {
      "$value": "47px",
      "px": 47,
      "env": "env(safe-area-inset-top, 0px)",
      "$type": "dimension",
      "$description": "Top safe area inset alias"
    },
    "bottom": {
      "$value": "34px",
      "px": 34,
      "env": "env(safe-area-inset-bottom, 0px)",
      "$type": "dimension",
      "$description": "Bottom safe area inset alias"
    }
  },
  "thumbZone": {
    "natural": {
      "$value": 40,
      "ratio": 0.40,
      "percentage": "40%",
      "$type": "number",
      "$description": "Natural thumb zone occupying bottom 40% of viewport"
    },
    "reach": {
      "$value": 35,
      "ratio": 0.35,
      "percentage": "35%",
      "$type": "number",
      "$description": "Reach thumb zone occupying middle 35% of viewport"
    },
    "hard": {
      "$value": 25,
      "ratio": 0.25,
      "percentage": "25%",
      "$type": "number",
      "$description": "Hard thumb zone occupying top 25% of viewport"
    }
  },
  "zIndex": {
